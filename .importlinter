[importlinter]
root_packages =
    core
    services
    adapters

[importlinter:contract:core-isolation]
name = core must not import from services or adapters at module level
type = forbidden
source_modules =
    core
forbidden_modules =
    services
    adapters
# Every entry here is an import written inside a function body, which is the
# mechanism that keeps `core` importable without the adapters installed.
# import-linter does not distinguish a lazy import from a module-level one, so
# each has to be named. `tests/fitness/test_optional_dependencies.py` is the
# check that does make the distinction, and it is what stops one of these
# becoming a real top-level import behind the exemption.
# Three of these are gone: the experiment builder used to rebuild a retriever
# or a generator by looking at the name of its class and importing the adapter
# of that name, so `core` reached into `adapters.qdrant`, `adapters.opensearch`
# and `adapters.ollama_generator` to do it. Making a variant of itself is the
# component's own knowledge now (`core.interfaces.BoundToACorpus` and the three
# protocols beside it), so `core` asks and imports nothing. This checker fails
# on an exemption that matches nothing, which is how it says so.
ignore_imports =
    core.pipeline -> adapters.langfuse_tracer
    core.experiment.runner -> adapters.http_pipeline
