# Copy to .env and edit. install.sh does the copy on first run and never
# overwrites an existing .env.
#
# Every variable here has a working default in code, so an empty .env starts a
# working platform. What follows is the list of what can be changed and why.

# ── Models ────────────────────────────────────────────────────────────────────
# Ollama runs on the host rather than in Docker: the container it used to run in
# had no GPU access on macOS by construction, and it published this port
# unconditionally, which broke `docker compose up` on any machine already
# running Ollama natively.
OLLAMA_BASE_URL=http://localhost:11434

# The model that answers. Also the default the demo realm records.
OLLAMA_MODEL=qwen3:8b

# The model that judges, used only by `make test-eval`. A genuinely
# non-thinking instruct model, because a thinking one turns each judge call
# from seconds into minutes.
DEEPEVAL_JUDGE_MODEL=qwen2.5:7b-instruct-q4_K_M

# Load the real embedder rather than hash vectors. Leaving this false makes
# every similarity number noise while everything still appears to work, which
# is the failure this platform exists to catch. install.sh sets it explicitly.
USE_REAL_BGE_M3=true

# ── Storage ───────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=ragplatform
REDIS_URL=redis://localhost:6379

# Neo4j sits behind the `graph` compose profile and is optional: only the
# GraphRAG pipeline reads it.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragplatform

# ── Tracing ───────────────────────────────────────────────────────────────────
# Local-only Langfuse. These keys are self-issued by the compose stack and
# authenticate nothing outside this machine.
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_EXTERNAL_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=lf-pk-local-causa-rag
LANGFUSE_SECRET_KEY=lf-sk-local-causa-rag

# ── Gateway ───────────────────────────────────────────────────────────────────
PORT=8081

# Restrict which URLs HttpPipeline may call, as a comma-separated list of
# prefixes. Empty means no restriction, which is the local-development default;
# set it when the gateway is reachable by anyone but you.
RAG_HTTP_ALLOWLIST=
